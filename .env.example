# Flask Core Configuration
SECRET_KEY=your-secret-key-here
FLASK_APP=app.py
FLASK_ENV=development
# APP_HOST_URL=http://192.168.1.100:5000  # Optional base URL for LAN / Remote / Production access

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_shopping_assistant
DB_USER=root
DB_PASSWORD=your-mysql-password

# Gmail SMTP Email Configuration
# Note: For Gmail, MAIL_PASSWORD must be a 16-character App Password generated from Google Account Security.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# AI Assistant Configuration
GEMINI_API_KEY=your-gemini-api-key

# Security & OTP Configuration
OTP_EXPIRY_MINUTES=5