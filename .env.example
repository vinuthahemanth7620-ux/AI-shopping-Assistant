# Flask Core Configuration
SECRET_KEY=your-secret-key-here
FLASK_APP=app.py
FLASK_ENV=development

# Optional: Base URL for LAN or deployed application
# APP_HOST_URL=http://YOUR_LOCAL_IP:5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_shopping_assistant
DB_USER=root
DB_PASSWORD=your-mysql-password

# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password
MAIL_DEFAULT_SENDER=AI Shopping Assistant <your-email@gmail.com>

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# OTP Configuration
OTP_EXPIRY_MINUTES=5